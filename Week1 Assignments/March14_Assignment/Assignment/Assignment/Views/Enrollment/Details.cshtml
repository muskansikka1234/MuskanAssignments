@model Assignment.Models.StudentDetailVM

@{
    ViewData["Title"] = "Student Details";
}

<h2>@Model.Name (@Model.Branch)</h2>

<table border="1">
    <tr>
        <th>Course</th>
        <th>Credits</th>
        <th>Department</th>
        <th>Latest Grade</th>
    </tr>

    @foreach (var c in Model.Courses)
    {
        <tr>
            <td>@c.Title</td>
            <td>@c.Credits</td>
            <td>@c.Department</td>
            <td>@c.LatestGrade</td>
        </tr>
    }

</table>

<br>

<a href="/Enrollment">Back</a>