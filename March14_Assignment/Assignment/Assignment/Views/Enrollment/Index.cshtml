@model List<Assignment.Models.StudentCoursesVM>

@{
    ViewData["Title"] = "Student Course List";
}

<h2>Student Course List</h2>

<table border="1">
    <tr>
        <th>Student Name</th>
        <th>Branch</th>
        <th>Course Count</th>
        <th>Course Titles</th>
        <th>Details</th>
    </tr>

    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Name</td>
            <td>@s.Branch</td>
            <td>@s.CourseCount</td>
            <td>@string.Join(", ", s.CourseTitles)</td>
            <td>
                <a href="/Enrollment/Details?studentId=@(Model.IndexOf(s) + 1)">View</a>
            </td>
        </tr>
    }

</table>